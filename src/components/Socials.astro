---
// Where to find this business online. Generated from the accounts connected in Hubert; every link was checked to
// resolve before it was added. Edit here if an account moves.
---
<div class="socials">
  <h4 class="socials-title">Find us online</h4>
  <div class="socials-row">
  <a class="socials-link socials-link--brand" href="https://www.google.com/maps/place/?q=place_id:ChIJfSjcxfyn3IgRNl8JgYSOs78" target="_blank" rel="noopener noreferrer" aria-label="Jason's Mobile Mechanics on Google">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M23.52 12.27c0-.82-.07-1.6-.21-2.36H12v4.47h6.46a5.53 5.53 0 0 1-2.4 3.63v3.01h3.88c2.27-2.09 3.58-5.17 3.58-8.75z" fill="#4285F4"/><path d="M12 24c3.24 0 5.96-1.08 7.94-2.91l-3.88-3.01c-1.08.72-2.45 1.15-4.06 1.15-3.13 0-5.78-2.11-6.72-4.95H1.26v3.11A12 12 0 0 0 12 24z" fill="#34A853"/><path d="M5.28 14.28a7.2 7.2 0 0 1 0-4.56V6.61H1.26a12 12 0 0 0 0 10.78l4.02-3.11z" fill="#FBBC05"/><path d="M12 4.77c1.76 0 3.35.61 4.6 1.8l3.44-3.44C17.95 1.19 15.23 0 12 0A12 12 0 0 0 1.26 6.61l4.02 3.11C6.22 6.88 8.87 4.77 12 4.77z" fill="#EA4335"/></svg>
    <span>Google</span>
  </a>
  </div>
</div>

<style>
  .socials {
    margin: 28px 0 0;
    padding-top: 22px;
    border-top: 1px solid rgba(128, 128, 128, 0.25);
  }
  .socials-title {
    margin: 0 0 12px;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: inherit;
    opacity: 0.85;
  }
  .socials-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .socials-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 15px;
    border: 1px solid rgba(128, 128, 128, 0.3);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1;
    transition: border-color 0.18s ease, transform 0.18s ease, background-color 0.18s ease;
  }
  .socials-link:hover,
  .socials-link:focus-visible {
    border-color: currentColor;
    background-color: rgba(128, 128, 128, 0.12);
    transform: translateY(-1px);
  }
  .socials-link svg {
    flex: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .socials-link {
      transition: none;
    }
    .socials-link:hover,
    .socials-link:focus-visible {
      transform: none;
    }
  }
  @media (max-width: 480px) {
    .socials-link span {
      display: none;
    }
    .socials-link {
      padding: 10px;
    }
  }
</style>
