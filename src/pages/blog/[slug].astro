---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import { formatDate, getPosts, readingTime } from '../../lib/content';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { site } from '../../lib/site';
import { emHtml } from '../../lib/text';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const author = data.author ?? site.business.name;
const date = formatDate(data.date);
const minutes = readingTime(post.body ?? '');
const jsonLd = [blogPostingSchema({ ...data, path }), breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: data.title, path }]), ...(data.faqs.length > 0 ? [faqSchema(data.faqs)] : [])];
---

<Base title={`${data.title} | ${site.brand.logoText}`} description={data.description} image={data.image} ogType="article" jsonLd={jsonLd}>
  <section class="hero section-dark">
    <div class="container">
      <div class="hero-eyebrow">Blog &mdash; <a href="/blog" style="color:inherit">All Articles</a></div>
      <h1 set:html={emHtml(data.title)} />
      <p class="hero-lead">{data.description}</p>
      <p class="hero-lead" style="font-size:0.9rem;opacity:0.8">{date} &middot; {author} &middot; {minutes}</p>
    </div>
  </section>
  <section class="section-cream">
    <div class="container">
      <article class="about-text" style="max-width:780px;margin:0 auto;">
      {data.image && <Picture src={data.image} alt={data.imageAlt ?? ''} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 760px" />}
      <Content />
      {data.faqs.length > 0 && (
        <>
          <h2>Frequently Asked Questions</h2>
          <div>{data.faqs.map((f) => (<details style="margin-bottom:12px"><summary style="font-weight:700;cursor:pointer">{f.question}</summary><p>{f.answer}</p></details>))}</div>
        </>
      )}
      </article>
    </div>
  </section>

</Base>
