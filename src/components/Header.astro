---
// Static header ported from the original site. Links already point at the new addresses.
---
<header class="site-header">
  <div class="container">
    <a href="/" class="logo">
      <div class="logo-icon">
        <svg width="24" height="24" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M45.5 21.8a9.3 9.3 0 0 1-11.9 11l-14 14a3.6 3.6 0 0 1-5.1-5.1l14-14a9.3 9.3 0 0 1 11-11.9l-6.2 6.2 1.9 5 5 1.9 6.2-6.2z" fill="#fff"></path></svg>
      </div>
      <span class="logo-name">Jason's Mobile Mechanics<span class="logo-sub">Port Charlotte &amp; Southwest Florida</span></span>
    </a>
    <nav class="main-nav">
      <button class="nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
        Menu
        <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <div class="nav-dropdown-menu" hidden="">
        <a href="/services">Services</a>
        <a href="/about">About &amp; Contact</a>
      </div>
    </nav>
    <div class="header-cta">
      <a href="tel:+18632669708" class="btn-call" onclick="if(typeof gtag==='function')gtag('event','call_click',{'event_category':'engagement','event_label':'header_phone_button'})">
        <span class="call-label">Call Now</span>
        <span class="call-num">863-266-9708</span>
      </a>
    </div>
  </div>
</header>
